<?xml version="1.0"?>
<!-- PaperKiosk as a mesquite (WAF) app: same runtime as the browser, but without the browser chrome. -->
<widget id="com.github.paperkiosk" version="1.0" viewmodes="application" xmlns="http://www.w3.org/ns/widgets" xmlns:kindle="http://kindle.amazon.com/ns/widget-extensions">
    <name xml:lang="en">PaperKiosk</name>
    <description xml:lang="en">Home Assistant control panel</description>
    <content src="index.html"/>
    <kindle:permissions>
        <kindle:permission name="local-port-access"/>
    </kindle:permissions>
    <kindle:cookiejar>
        <kindle:asset key="persistent" value="true"/>
    </kindle:cookiejar>
    <kindle:chrome>
        <kindle:asset key="configureSearchBar" value="none"/>
    </kindle:chrome>
    <!-- No <kindle:gestures>: with tap gestures enabled, mesquite dispatches taps to app JS (Kindle.js
         handlers we don't have) and segfaults. Without it WebKit handles taps like a normal page. -->
    <feature name="http://kindle.amazon.com/apis" required="true">
        <param name="appmgr" value="yes"/>
        <param name="net" value="yes"/>
        <param name="messaging" value="yes"/>
        <param name="dev" value="yes"/>
    </feature>
    <kindle:settings>
        <kindle:setting name="internetRequired" value="yes"/>
    </kindle:settings>
</widget>
