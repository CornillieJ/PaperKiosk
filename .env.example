# Made by ./install.sh (scripts/10-configure.sh and 20-home-assistant.sh); edit and run `docker compose up -d`.

# Home Assistant, as seen from inside the container. HA on this same machine: http://host.docker.internal:8123
HA_URL=http://homeassistant.local:8123
# Time zone for the clock, the downtime hours and the weather (a TZ database name like Europe/Amsterdam).
TZ=
# Port on this machine. Keep it on your LAN: never forward it in your router.
PAPERKIOSK_PORT=8100
# Address to listen on: 0.0.0.0 (all, needed for the Kindle) or 127.0.0.1 (only via a reverse proxy here).
PAPERKIOSK_BIND=0.0.0.0
# How screens reach this server (the installer fills it in, e.g. http://192.168.1.10:8100).
PAPERKIOSK_URL=
# Owner of ./data and ./secrets (your user: `id -u` / `id -g`).
PUID=1000
PGID=1000
# Container name (change it to run a second PaperKiosk on the same machine).
PAPERKIOSK_CONTAINER=paperkiosk

# Kindle (scripts/40-kindle-install.sh, 50-kindle-setup.sh and kindle/tools)
# Its IP address on your Wi-Fi (fixed in the router is best) and how the installer reached it.
# Screen type from step 4 (kindle, other, skip)
SCREEN=
KINDLE_NAME=
KINDLE_IP=
KINDLE_SSH=no
